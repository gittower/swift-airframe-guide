---
import ShellLayout from './ShellLayout.astro';

interface ChildDoc {
  href: string;
  title: string;
  order: number;
  subOrder?: number;
}

interface Props {
  title: string;
  description: string;
  order: number;
  subOrder?: number;
  parentTitle?: string | null;
  children?: ChildDoc[];
  prevDoc?: { href: string; title: string } | null;
  nextDoc?: { href: string; title: string } | null;
}

const {
  title,
  description,
  order,
  subOrder,
  parentTitle = null,
  children = [],
  prevDoc = null,
  nextDoc = null,
} = Astro.props;

const isSub = subOrder !== undefined;
const gate = isSub ? `${String(order).padStart(2, '0')}.${subOrder}` : String(order).padStart(2, '0');
const chapterLabel = isSub ? `${order}.${subOrder}` : String(order);
---

<ShellLayout title={title} description={description}>
  <article class="page">
    <p class="eyebrow">
      Chapter {chapterLabel} &nbsp;·&nbsp; Gate {gate}
      {isSub && parentTitle && <>&nbsp;·&nbsp; {parentTitle}</>}
    </p>
    <h1>{title}</h1>

    {
      children.length > 0 && (
        <nav class="subchapter-strip" aria-label="In this chapter">
          <span class="subchapter-label">In this chapter</span>
          <ul>
            {children.map((child) => (
              <li>
                <a href={child.href}>
                  {String(child.order).padStart(2, '0')}.{child.subOrder} {child.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose">
      <slot />
    </div>

    <nav class="chapter-foot">
      <span>
        {
          prevDoc && (
            <a href={prevDoc.href}>
              <span class="dir">Previous</span>← {prevDoc.title}
            </a>
          )
        }
      </span>
      <span>
        {
          nextDoc && (
            <a href={nextDoc.href}>
              <span class="dir">Next</span>
              {nextDoc.title} →
            </a>
          )
        }
      </span>
    </nav>
  </article>
</ShellLayout>

<style>
  .page {
    padding: 56px 64px 8px;
    max-width: 900px;
  }

  .eyebrow {
    font-family: var(--font-display), var(--font-display-fallback);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent-ink);
    margin: 0 0 14px;
  }

  h1 {
    font-family: var(--font-display), var(--font-display-fallback);
    font-weight: 800;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    letter-spacing: -0.005em;
    margin: 10px 0 34px;
    text-wrap: balance;
  }

  .subchapter-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 34px;
  }

  .subchapter-label {
    font-family: var(--font-display), var(--font-display-fallback);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .subchapter-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .subchapter-strip a {
    display: inline-block;
    font-family: var(--font-mono), var(--font-mono-fallback);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--pill-ink);
    background: var(--pill-bg);
    padding: 5px 12px;
    border-radius: 999px;
    transition: background-color 0.15s ease;
  }

  .subchapter-strip a:hover {
    background: var(--accent);
    color: #06131f;
  }

  .chapter-foot {
    margin-top: 56px;
    padding: 26px 0 60px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid var(--line);
    max-width: 900px;
  }

  .chapter-foot a {
    font-family: var(--font-display), var(--font-display-fallback);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--accent-ink);
  }

  .chapter-foot a:hover {
    text-decoration: underline;
  }

  .chapter-foot .dir {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    margin-bottom: 3px;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .page {
      padding: 40px 28px 8px;
    }
  }
</style>
